{
  "name": "agent-brain",
  "version": "0.9.5",
  "description": "Obsidian plugin: watch your AI coding agent (Claude Code for now) work as live activity on a real MRI brain. Local only, uses no tokens.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mucahitkumlay/agent-brain.git"
  },
  "scripts": {
    "prepare-assets": "node tools/prepare.mjs",
    "build": "node tools/prepare.mjs && node tools/build.mjs",
    "dev": "node tools/prepare.mjs && node tools/build.mjs --watch",
    "test": "node test/run.mjs",
    "harness": "node dev/prepare.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "config": {
    "anatomyRelease": "anatomy-1"
  }
}
